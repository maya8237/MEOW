{
  "description": "MEOW: keep custom skills and hooks registered with Claude Code.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v meow >/dev/null 2>&1 && meow sync --auto --work-dir \"${CLAUDE_PROJECT_DIR:-.}\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
