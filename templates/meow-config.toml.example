# meow-config.toml.example -- shared project configuration for MEOW.
# Copy this file to the project as `.meow/config.toml` and remove settings you
# do not use. Configuration priority is local project config, shared project
# config, user `~/.meow/config.toml`, then MEOW defaults. Keep secrets and
# user-specific project overrides in `.meow/config.local.toml` or the user
# config instead of this shared file.

max_rounds = 8
docs_dir = ".meow/plans"

# Commands are launched without shell evaluation. `$NAME`, `${NAME}`, and
# `%NAME%` are expanded from the process environment on Windows and Linux.

# Skills enabled for every role and optional role-specific additions. Built-in
# MEOW skills remain enabled. These lists append across user/shared/local config
# rather than overriding lower-level skill lists.
[agent_skills]
default = []
# explorer = ["project-search"]
# reviewer = ["security-review"]

# Shared Jira project/server settings. Put credentials in the environment or
# `.meow/config.local.toml`, never in this file.
# [jira]
# project_key = "PROJ"
# branch_prefix = "issue/"
# [jira.mcp]
# command = "uvx"
# args = ["mcp-atlassian"]

# Shared GitLab MCP launcher settings. Put tokens in the environment or local
# config. The URL can be shared; credentials should not be.
# [gitlab.mcp]
# command = "npx"
# args = ["your-gitlab-mcp-package"]
# [gitlab.mcp.env]
# GITLAB_URL = "https://gitlab.example.com"

# Shared GitHub MCP launcher settings. Put tokens in the environment or local
# config. The pull-request URL is supplied to `meow review --github`.
# [github.mcp]
# command = "npx"
# args = ["your-github-mcp-package"]
# [github.mcp.env]
# GITHUB_PERSONAL_ACCESS_TOKEN = "<token>"

# Add one or more project lint commands as needed.
# [[lint]]
# command = "python -m ruff check"
# fix_flag = "--fix"

# Optional required or advisory build gates. Commands use argv semantics; they
# are not evaluated by a shell.
# [[build]]
# command = "python -m compileall src"
# required = true
# timeout = 300

# Optional tester commands and a local development server.
# [tester]
# test_dirs = ["tests"]
# [[tester.tests]]
# command = "python -m pytest -q"
# gate = true
# [[tester.dev_server]]
# command = "npm run dev"
# cwd = "web"
# ready_url = "http://127.0.0.1:3000/health"
# startup_timeout = 30

# Optional browser provider. `kind` is `skill`, `mcp`, or `command`; all
# providers require a name and entrypoint. Command providers may also set
# args, cwd, env, timeout, flows, and repository-relative artifacts.
# [tester.browser]
# kind = "command"
# name = "project-browser"
# entrypoint = "python -m project_browser"
# required = false
# flows = ["smoke"]
# artifacts = [".meow/browser"]

# Optional setup for newly-created feature worktrees. Copy only regular,
# non-secret-like relative files; commands are literal argument arrays.
# [worktree_setup]
# copy = [".env.example"]
# commands = [["python", "-m", "pip", "install", "-e", "."]]

# Optional role/tool policy. Path-scoped rules are only valid for Read, Write,
# Edit, or NotebookEdit and require Bash and Agent to be denied for that role.
# [[permissions.rule]]
# role = "generator"
# tool = "Bash"
# action = "deny"

# Optional delivery defaults; credentials are never stored here.
# [delivery]
# target_branch = "dev"
# [delivery.gitlab]
# enabled = false
