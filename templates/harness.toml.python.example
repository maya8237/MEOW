# harness.toml.python.example -- legacy-compatible Python config template.
#
# Copy to the project as `.meow/config.toml` (or retain `.harness.toml` only for
# compatibility). This one assumes ruff for the
# fast, auto-fixing gate and mypy as an advisory, project-wide type check --
# adjust commands to whatever this project actually uses.
#
# See harness.toml.example (in this same directory) for the fully annotated,
# language-neutral version of every field.

max_rounds = 8
docs_dir = ".meow/plans"

[models]
explorer = "haiku"

# Gate: per-file, auto-fixing, and its project-wide failure fails the sprint.
[[lint]]
command = "ruff check"
fix_flag = "--fix"

# Advisory: mypy has no fix mode and pre-existing type debt shouldn't block a
# sprint on its own -- it just gets reported in the reviewer's review.
[[lint]]
command = "mypy ."
per_file = false
gate = false
