# harness.toml.typescript.example -- legacy-compatible TypeScript/JavaScript
# config template.
#
# Copy to the project as `.meow/config.toml` (or retain `.harness.toml` only for
# compatibility). This one assumes eslint for the
# auto-fixing gate and tsc as an advisory, project-wide type check -- swap
# eslint for `npx oxlint` if this project uses that instead (also auto-fixing,
# generally faster).
#
# See harness.toml.example (in this same directory) for the fully annotated,
# language-neutral version of every field.

max_rounds = 8
docs_dir = ".meow/plans"

[models]
explorer = "haiku"

# Gate: per-file, auto-fixing, and its project-wide failure fails the sprint.
[[lint]]
command = "npx eslint"
fix_flag = "--fix"

# Advisory: tsc has no fix mode and no per-file mode worth using -- it just
# gets reported in the reviewer's review, never fails the sprint on its own.
[[lint]]
command = "npx tsc --noEmit"
per_file = false
gate = false
