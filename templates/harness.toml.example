# harness.toml.example -- template, from the meow harness repo.
#
# Copy this to the root of a project that uses the installed harness engine,
# renamed to `.harness.toml`, then fill in the real values.
# Run with: harness run "your feature request"   (from that project's root)
#
# NOTE ON TOML: every top-level key must appear ABOVE the first [[lint]]
# table. Anything written after one belongs to that table, not to the file.
# The engine rejects the config with a clear error if you get this wrong.

# How many generator <-> reviewer rounds to allow before giving up on a
# sprint rather than looping forever.
max_rounds = 8

# Where sprint plan/contract/review files get written, relative to this
# project's root. Must already exist as part of the project's docs/ setup.
docs_dir = "docs/exec-plans/active"

# Optional per-role model overrides. Omit a line to use the engine's default
# for that role.
[models]
explorer = "haiku"
# planner = "claude-sonnet-5"
# generator = "claude-opus-5-5"
# reviewer = "claude-opus-5-5"

# Optional -- only needed for `meow issue`. Declares the Jira project
# to search and how to launch the Jira MCP server it talks to. The server's
# own credentials (JIRA_URL, JIRA_USERNAME, JIRA_API_TOKEN, or
# JIRA_PERSONAL_TOKEN for Server/Data Center) belong in the environment, not
# here. See GUIDE.md's "Running on a schedule" section.
# [jira]
# project_key = "PROJ"
# branch_prefix = "issue/"   # optional, this is the default
#
# [jira.mcp]
# command = "uvx"
# args = ["mcp-atlassian"]

# ---------------------------------------------------------------------------
# Lint commands -- one [[lint]] table per command, any number of them.
#
#   command   required. The check-only command, WITHOUT any fix flag.
#   fix_flag  optional. Appended when linting a single file, so the hook can
#             auto-fix. Omit for a command that has no fix mode.
#   per_file  optional, default true. Run as a hook on each file the
#             generator writes. Set false for whole-project analysis that
#             means nothing when pointed at one file.
#   gate      optional, default true. A project-wide failure is a sprint
#             FAIL. Set false to make a command advisory -- what you want
#             for an analyzer that reports findings on pre-existing code.
#
# Commands run in the order listed. The program is resolved on PATH, so
# `npx ...` works on Windows where the shim is a .cmd file.
# ---------------------------------------------------------------------------

[[lint]]
command = "<your-lint-command>"   # e.g. "ruff check", "eslint", "npx oxlint"
fix_flag = "--fix"

# A second, project-only advisory check. Delete if you don't have one.
# [[lint]]
# command = "npx fallow"
# per_file = false
# gate = false

# ---------------------------------------------------------------------------
# The older single-command form still works, and is equivalent to one
# [[lint]] entry that is both per-file and a gate. Prefer [[lint]].
#
#   lint_command = "ruff check"
#   lint_fix_flag = "--fix"
# ---------------------------------------------------------------------------
