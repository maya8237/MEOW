# harness.toml.example -- template, from the meow harness repo.
#
# Copy this to the root of a project that uses the installed harness engine,
# renamed to `.harness.toml`, then fill in the real values.
# Run with: harness run "your feature request"   (from that project's root)
#
# NOTE ON TOML: every top-level key must appear ABOVE the first [[lint]]
# table. Anything written after one belongs to that table, not to the file.
# The engine rejects the config with a clear error if you get this wrong.

# How many generator <-> reviewer rounds to allow before giving up on a
# sprint rather than looping forever.
max_rounds = 8

# Where sprint plan/contract/review files get written, relative to this
# project's root. Must already exist as part of the project's docs/ setup.
docs_dir = "docs/exec-plans/active"

# Seconds before a per-file lint command is killed.
# lint_timeout = 60

# Optional per-role model overrides. Omit a line to use the engine's default
# for that role.
[models]
explorer = "haiku"
# planner = "claude-sonnet-5"
# generator = "claude-opus-5-5"
# reviewer = "claude-opus-5-5"

# Optional -- only needed for `meow run --jira`. Declares the Jira project
# to search and how to launch the Jira MCP server it talks to. The server's
# own credentials (JIRA_URL, JIRA_USERNAME, JIRA_API_TOKEN, or
# JIRA_PERSONAL_TOKEN for Server/Data Center) belong in the environment, not
# here. See docs/INTEGRATIONS.md for scheduled runs.
# [jira]
# project_key = "PROJ"
# branch_prefix = "issue/"   # optional, this is the default
#
# [jira.mcp]
# command = "uvx"
# args = ["mcp-atlassian"]

# Optional -- only needed for `meow review --gitlab`. Declares how to launch
# the GitLab MCP server it talks to fetch a merge request's diff; unlike
# [jira], no project key is needed since the merge request URL is passed on
# the command line each time. There is no single de facto GitLab MCP server
# the way mcp-atlassian is for Jira -- pick one that exposes merge-request
# read tools.
#
# Unlike [jira.mcp] (whose server reads its own credentials from the
# environment), [gitlab.mcp.env] is passed straight through as that
# server's environment when meow launches it -- set whatever variables
# your chosen server needs (typically a GitLab URL and a personal/project
# access token) directly here, by name.
#
# SECURITY: .harness.toml is an ordinary project file, meant to be
# committed like any other config -- it is NOT gitignored. Putting a real
# access token in [gitlab.mcp.env] commits that secret to your repo's
# history in plain text, readable by anyone with read access (including
# forks, CI logs, etc.) and hard to fully revoke even after rotating it.
# If that's not acceptable for your repo, don't put the real value here --
# keep the token in your actual shell/CI environment instead and reference
# it in [gitlab.mcp.env] however your chosen MCP server supports (e.g. if
# it supports variable expansion in its own config), or gitignore this
# file (or a local override of it) if your project's conventions allow that.
# [gitlab.mcp]
# command = "<program that launches your GitLab MCP server>"
# args = []
#
# [gitlab.mcp.env]
# GITLAB_URL = "https://gitlab.example.com"
# GITLAB_TOKEN = "<your GitLab personal/project access token>"

# ---------------------------------------------------------------------------
# Lint commands -- one [[lint]] table per command, any number of them.
#
#   command   required. The check-only command, WITHOUT any fix flag.
#   fix_flag  optional. Appended when linting a single file, so the hook can
#             auto-fix. Omit for a command that has no fix mode.
#   per_file  optional, default true. Run as a hook on each file the
#             generator writes. Set false for whole-project analysis that
#             means nothing when pointed at one file.
#   gate      optional, default true. A project-wide failure is a sprint
#             FAIL. Set false to make a command advisory -- what you want
#             for an analyzer that reports findings on pre-existing code.
#
# Commands run in the order listed. The program is resolved on PATH, so
# `npx ...` works on Windows where the shim is a .cmd file.
# ---------------------------------------------------------------------------

[[lint]]
command = "<your-lint-command>"   # e.g. "ruff check", "eslint", "npx oxlint"
fix_flag = "--fix"

# A second, project-only advisory check. Delete if you don't have one.
# [[lint]]
# command = "npx fallow"
# per_file = false
# gate = false

# ---------------------------------------------------------------------------
# The older single-command form still works, and is equivalent to one
# [[lint]] entry that is both per-file and a gate. Prefer [[lint]].
#
#   lint_command = "ruff check"
#   lint_fix_flag = "--fix"
# ---------------------------------------------------------------------------

# Configured tests use the managed tester stage and may run with dev servers.
# gate = true is the default; gate = false makes one test advisory.
# [tester]
# [[tester.tests]]
# command = "python -m pytest -q"
# gate = true
# timeout = 300

# Optional project-owned browser integration. MEOW validates this declaration
# and records bounded evidence; the skill or MCP server owns browser actions.
# [tester.browser]
# kind = "skill"                 # "skill" or "mcp"
# name = "project-browser"
# entrypoint = "check"
# permissions = ["read_browser"]
# required = false

# Build checks are separate from tests and lint. Omit if no build is needed.
# required = true is the default; false records an advisory failure.
# [[build]]
# command = "python -m compileall src"
# required = true
# timeout = 300
